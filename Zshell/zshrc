# WildfootW's zshrc — Linux only (Ubuntu / RHEL). macOS support removed.

# ---------------------------------------------------------------------------
# oh-my-zsh
# ---------------------------------------------------------------------------
export DOTFILES=$HOME/dotfiles
export ZSH=$DOTFILES/Zshell/ohmyzsh

# Prompt is handled by starship (see bottom of file), so no oh-my-zsh theme.
ZSH_THEME=""

# zsh-syntax-highlighting must be loaded last in this list.
plugins=(git pip vi-mode history-substring-search zsh-autosuggestions zsh-syntax-highlighting)

# Load docker / tmux plugins only when those tools exist.
if command -v docker > /dev/null 2>&1; then
    plugins=(docker $plugins)
fi
ZSH_TMUX_AUTOSTART=true
ZSH_TMUX_AUTOQUIT=false
plugins=(tmux $plugins)

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
source $DOTFILES/Misc/environment_variable.sh
setopt correct

# Prepend ~/.local/bin so user-installed tools (nvim tarball, fnm, uv, starship)
# win over distro packages. Do NOT reset PATH from scratch: login already set it
# up, and WSL / Docker Desktop / snap inject paths (e.g. the docker credential
# helper, /snap/bin) that we must keep. `typeset -U` de-dupes; the trailing
# standard dirs are a fallback for the rare minimal-PATH shell.
typeset -U path
path=("$HOME/.local/bin" $path /usr/local/bin /usr/local/sbin /usr/bin /bin /usr/sbin /sbin)
export PATH

source $ZSH/oh-my-zsh.sh

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------
## Programming
alias gg++="g++ -std=c++20 -O2 -g"

## Security
alias pwn-search_pid="ps -ef | grep"
alias pwn-open_socket="ncat -kl 8888 -ve"
alias pwn-gdb_attach="sudo gdb -p"
alias pwn-cp_my_pwn_tools="cp ~/dotfiles/Misc/pwn/my_pwn_tools.py ."
alias pwn-docker-run="docker run --rm --cap-add=SYS_PTRACE --security-opt seccomp=unconfined --volume \"$HOME\":\"$HOME\" -it -P"
alias objdumpi="objdump -M intel"
alias nmap-scan-initial="nmap -A -sC -sV -oN nmap.initial.log"
alias nmap-scan-all-port="nmap -p- -vvv -oN nmap.all_port.log"
alias nmap-scan-snmp="nmap -sU -n -p 161 -sC -oN nmap.snmp.log"
alias nmap-scan-udp="nmap -sU -oN nmap.udp.log"

## Other
alias v="nvim"
alias checkport="sudo lsof -n -i | grep LISTEN"
alias docker-pid="sudo docker ps -q | sudo xargs docker inspect --format 'Pid:{{.State.Pid}} ID:{{.ID}} | {{.Config.Hostname}}'"
alias docker-attach="sudo env SHELL='/bin/bash' nsenter --mount --uts --ipc --net --pid --target"
alias wget_file_system="wget -r -np -R 'index.html*'"
alias find_string_here="grep -rnw './' -e"
alias open_folder='nautilus $PWD'
alias get_log='tail -f /var/log/syslog'
alias weather='curl wttr.in'
alias docker-compose='docker compose'
function rebuild_service() {
    docker-compose build "$1" && docker-compose up "$1"
}
alias git-rev-list-size="git rev-list --objects --all | git cat-file --batch-check='%(objecttype) %(objectname) %(objectsize) %(rest)' | sort -k3nr"

# Distro-specific convenience
if command -v apt-get > /dev/null 2>&1; then
    alias apt-uu='sudo apt-get update && sudo apt-get upgrade'
elif command -v dnf > /dev/null 2>&1; then
    alias dnf-uu='sudo dnf upgrade --refresh'
fi

# ---------------------------------------------------------------------------
# Tooling integrations
# ---------------------------------------------------------------------------
# fzf — use `fzf --zsh` (0.48+); older distro fzf (e.g. Ubuntu 24.04's 0.44)
# lacks it, so fall back to the packaged integration scripts.
if command -v fzf > /dev/null 2>&1; then
    if fzf --zsh > /dev/null 2>&1; then
        eval "$(fzf --zsh)"
    else
        for _f in ~/.fzf.zsh \
                  /usr/share/doc/fzf/examples/key-bindings.zsh \
                  /usr/share/doc/fzf/examples/completion.zsh; do
            [ -f "$_f" ] && source "$_f"
        done
        unset _f
    fi
fi

# fnm — Node version manager (replaces nvm)
if command -v fnm > /dev/null 2>&1; then
    eval "$(fnm env --use-on-cd)"
fi

# uv — Python toolchain (replaces pyenv/pyenv-virtualenv); completions only
if command -v uv > /dev/null 2>&1; then
    eval "$(uv generate-shell-completion zsh)" 2>/dev/null
fi

# starship prompt (replaces the agnoster theme)
if command -v starship > /dev/null 2>&1; then
    eval "$(starship init zsh)"
fi

# SSH keys: no agent juggling here. The key uses the default name
# (~/.ssh/id_ed25519) which ssh tries automatically, and ssh-config sets
# `AddKeysToAgent yes`, so the agent loads it on first use.
